#import std::alloc { Allocator, Layout, align_of }
#import std::da { DynamicArray, da_new }
#import std::string { String }
#import std::panic { panic }

#guard target(windows)
    #include <stringapiset.h>

    typedef wchar_t native_char;

    #extern WideCharToMultiByte
    int wide_char_to_multi_byte(
        UINT   CodePage,
        DWORD  dwFlags,
        LPCWCH lpWideCharStr,
        int    cchWideChar,
        LPSTR  lpMultiByteStr,
        int    cbMultiByte,
        LPCCH  lpDefaultChar,
        LPBOOL lpUsedDefaultChar
    );

    static inline int get_wchar_len_in_char(const wchar_t* w, int wlen) {
        return wide_char_to_multi_byte(CP_UTF8, WC_ERR_INVALID_CHARS,
                                       w, wlen, NULL, 0, NULL, NULL);
    }

    static inline bool wide_to_utf8(const wchar_t* w, int wlen, int n, char* buf) {
        return wide_char_to_multi_byte(CP_UTF8, WC_ERR_INVALID_CHARS,
                                       w, wlen, buf, n, NULL, NULL) == n;
    }
#else
    typedef char native_char;
#endguard

/// A platform-native string.
typedef struct {
    DynamicArray[native_char] inner;
} NativeString;

/// Create an empty platform-native string.
#export
static inline NativeString native_string_new<alloc>(size_t .capacity) {
    DynamicArray[native_char] da = da_new<alloc>(.capacity = capacity);
    return { .inner = move(da) };
}

#guards static inline String NativeString..to_string<alloc: self>(const *self)
    #guard target(windows)
        #export
        static inline String NativeString..to_string<alloc: self>(const *self) {
            int n = get_wchar_len_in_char(self->inner..as_ptr(), self->inner..len());
            if (n <= 0) {
                @panic("failed to get wchar length");
            }

            DynamicArray da = da_new(.capacity = (size_t)n);
            bool result = wide_to_utf8(
                self->inner..as_ptr(),
                self->inner..len(),
                n,
                da->inner..as_ptr()
            );
            if (!result) {
                @panic("failed to transform wchar to char");
            }

            return da;
        }
    #else
        #export
        static inline String NativeString..to_string<alloc: self>(const *self) {
            return self->inner..copy();
        }
    #endguard
#endguards
