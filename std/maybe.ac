#include <stdbool.h>

#import std::panic { panic }
#import std::str { str }

#marker act::maybe(tag=present, target=value, empty=false) act::privateconstruct
#export
typedef struct {
    bool present;
    T value;
} Maybe[T];

static inline Maybe[T] none() {
    return { .present = false };
}

static inline Maybe[T] some(T value) {
    Maybe[T] res = { .present = true, .value = move(value) };
    return move(res);
}

#export
static inline bool Maybe[T]..is_some(*self) {
    return self->present;
}

#export
static inline bool Maybe[T]..is_none(*self) {
    return !self->present;
}

#export
static inline T Maybe[T]..unwrap_unchecked(self) {
    return move(self.value);
}

#export
static inline T Maybe[T]..unwrap(self) {
    if (self..is_none()) {
        @panic("found none during Maybe[T]..unwrap()");
    }
    return self..unwrap_unchecked();
}

#export
static inline T Maybe[T]..unwrap_or(self, T choice) {
    if (self..is_none()) {
        return move(choice);
    }
    return self..unwrap_unchecked();
}

#export { none, some }
