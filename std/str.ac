#include <stddef.h>
#include <string.h>

#import std::maybe { Maybe, some, none }
#import std::slice { Slice, slice_from_parts }

/// A fat string pointer.
///
/// This is also known as an immutable string slice.
typedef struct {
    Slice[char] inner;
} str;

/// Create a `str` slice from a C-style string.
///
/// # Safety
/// It should be guaranteed that the returned `str`
/// slice should be of the same lifetime as the provided
/// `cstr`.
str str_from_cstr(const char* cstr) {
    size_t len = strlen(cstr);
    return { slice_from_parts(len, cstr) };
}

str str_from_parts(size_t len, const char* ptr) {
    // FIXME: same as above
    return { slice_from_parts(len, ptr) };
}

const char* str..as_ptr(const *self) {
    return self->inner..as_ptr();
}

/// Gets the length of the str slice.
static inline size_t str..len(const *self) {
    return self->inner..len();
}

str str..slice(const *self, size_t start, size_t end) {
    return { self->inner..slice(start, end) };
}

#export { str_from_cstr, str_from_parts }
#export { str, str..slice, str..len, str..as_ptr }
