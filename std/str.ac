#include <stddef.h>
#include <string.h>

#import std::maybe { Maybe, some, none }

/// A fat string pointer.
///
/// This is also known as an immutable string slice.
typedef struct {
    size_t len;
    const char *ptr;
} str;

/// Create a `str` slice from a C-style string.
///
/// # Safety
/// It should be guaranteed that the returned `str`
/// slice should be of the same lifetime as the provided
/// `cstr`.
str str_from_cstr(const char* cstr) {
    size_t len = strlen(cstr);
    return { .len = len, .ptr = cstr };
}

str str..slice(*self, size_t start, size_t end) {
    if (end > self->len) {
        end = self->len;
    }
    if (start > end) {
        start = end;
    }

    return (str){
        .len = end - start,
        .ptr = self->ptr + start
    };
}

#export { str_from_cstr }
#export { str, str..slice }
