#import std::alloc { Allocator }
#import std::da { DynamicArray, da_new, da_with_capacity }
#import std::str { str, str_from_parts }
#import std::iter { Iter }
#import std::maybe { Maybe, some, none }

// String ==

typedef struct {
    DynamicArray[char] inner;
} String;

/// Creates a new `std::string { String }`. This function does
/// not allocate.
///
/// Unlike zero-initializing, this ensures that the given
/// `<alloc>` (allocator) is attached to the instance of this
/// string.
static inline String string_new<alloc>() {
    DynamicArray[char] da = da_new<alloc>();
    return (String){ .inner = move(da) };
}

/// Creates a new `std::string { String }`, and allocates a capacity
/// of at least `capacity` (unit: `char`).
static inline String string_with_capacity<alloc>(size_t capacity) {
    DynamicArray[char] da = da_with_capacity<alloc>(capacity);
    return (String){ .inner = move(da) };
}

static inline String string_from_cstr<alloc>(const char* cstr) {
    size_t len = strlen(cstr);
    DynamicArray[char] da = da_with_capacity<alloc>(len);
    memcpy(da.items, cstr, len);
    da.len = len;
    return (String){ .inner = move(da) };
}

static inline String string_from_str<alloc>(const str src) {
    DynamicArray[char] da = da_with_capacity<alloc>(src..len());
    memcpy(da.items, src..as_ptr(), src..len());
    da.len = src..len();
    return (String){ .inner = move(da) };
}

/// Appends a `char` to the string.
static inline void String..append<alloc: self>(*self, char chr) {
    self->inner..append(chr);
}

/// Reserves space of at least `capacity` (unit: `char`).
static inline void String..reserve<alloc: self>(*self, size_t capacity) {
    self->inner..reserve(capacity);
}

/// Pops off a character off the string, if it has one.
static inline Maybe[char] String..pop(*self) {
    return self->inner..pop();
}

/// Gets the length of the string.
static inline size_t String..len(const *self) {
    return self->inner.len;
}

/// Gets the character at the given index, if exists.
static inline Maybe[char] String..at(const *self, size_t index) {
    if (index >= self..len()) {
        return none();
    } else {
        return some(self->inner.items[index]);
    }
}

/// Gets a slice of the string.
/// This is a shorthand method for `..as_str()..slice(start, end)`.
static inline str String..slice(const *self, size_t start, size_t end) {
    str s = self..as_str();
    return s..slice(start, end);
}

/// Appends from a `str`.
static inline void String..append_str<alloc: self>(*self, str src) {
    self->inner.len += src..len();
    self->inner..reserve(self->inner.len);
    memcpy(self->inner.items, src..as_ptr(), src..len());
}

/// Gets a `str` slice representation of this string.
static inline str String..as_str(const *self) {
    return str_from_parts(self->inner.len, self->inner.items);
}

/// Gets the underlying character pointer.
static inline const char* String..as_ptr(const *self) {
    return self->inner.items;
}

/// Gets the underlying character pointer, as mutable.
static inline char* String..as_mutable_ptr(*self) {
    return self->inner.items;
}

/// Copies this string.
static inline void String..copy<alloc>(const *self) {
    return self->inner..copy<alloc>();
}

/// Converts this string into a temporary C-style string, which is
/// null-terminated.
static inline TempCString String..to_temp_cstring<alloc>(self) {
    // FIXME
    TempCString res = { move(self) };
    res.src..append('\0');
    return move(res);
}

// static inline void

#export { string_new, string_with_capacity, string_from_cstr, string_from_str }
#export { String, String..reserve, String..append, String..append_str, String..pop }
#export { String..at, String..copy, String..len }
#export { String..as_str, String..as_ptr, String..as_mutable_ptr }
#export { String..to_temp_cstring }

// == String

// TempCString ==

/// A temporary C-style string, which is null-terminated.
///
/// As the name suggests, it's temporary, and it should be
/// created from a `std::string { String }`.
#meta privateconstruct
typedef struct {
    String src;
} TempCString;


/// Gets the C-style string reference.
static inline const char* TempCString..as_cstr(const *self) {
    return self->src..as_ptr();
}

/// Gets a `str` slice representation of the underlying string.
/// However, the null byte is not part of the slice.
static inline str TempCString..as_str(const *self) {
    str s = self->src..as_str();
    return str_from_parts(s..len() - 1, s..as_ptr());
}

/// Converts this temporary C-style string back to an
/// `std::string { String }`.
static inline String TempCString..revert_to_string(self) {
    return move(self.src);
}

#export { TempCString, TempCString..as_cstr, TempCString..as_str, TempCString..revert_to_string }

// == TempCString

// StringIter ==

typedef struct {
    size_t counter;
    size_t len;
    const char *items;
} StringIter;

/// Gets an iterator over the string.
///
/// During iteration, the source string should never
/// mutate.
StringIter String..iter(const *self) {
    return { 0, self..len(), self->inner.items };
}

Maybe[char] (Iter[char])StringIter..next(*self) {
    if (self->counter >= self->len) {
        return none();
    }
    return some(self->items[self->counter++]);
}

#export { String..iter, StringIter }

// == StringIter

#tests

#import std::alloc { Allocator, general_allocator }

#test
void general() {
    Allocator gpa = general_allocator();
    String s = string_new<gpa>();
}

#endtests
