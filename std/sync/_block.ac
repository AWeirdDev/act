#import std::alloc { Layout, Allocator, layout_of }

/// A block contains both the underlying data and the
/// weak & strong count.
#marker act::privateconstruct
#export
typedef struct {
  T data;
  Size_T weak_count;
  Size_T strong_count;
} Block[Size_T, T];

/// Create a new block.
#export
static inline Block[Size_T, T] *block_new<alloc>(T data) {
    Block[Size_T, T] *ptr = alloc..allocate(@layout_of(Block[Size_T, T]));
    *ptr = (Block[Size_T, T]){ .data = data, 0 };
    return ptr;
}

/// Destroys a block. Unlike `drop()`, the transpiler treats it
/// as a normal method.
#export
static inline void Block[Size_T, T]..destroy<alloc>(*block) {
    alloc..deallocate(block, @layout_of(Block[Size_T, T]));
}
