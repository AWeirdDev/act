#include <stdio.h>

#import std::str { str }

/// size_t fwrite(const void *restrict ptr, size_t size, size_t nitems, FILE *restrict stream);
#extern fwrite fwrite

/// Prints text to stdout.
static inline void print(str text) {
    fwrite(text..as_ptr(), sizeof(*text..as_ptr()), text..len(), stdout);
}

/// Prints text to stdout, with a new line character.
static inline void println(str text) {
    fwrite(text..as_ptr(), sizeof(*text..as_ptr()), text..len(), stdout);
    fputc('\n', stdout);
}

#export { print, println }
