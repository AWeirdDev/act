#include <stdio.h>

#import std::str { str }

/// Prints text to stdout.
static inline void print(str text) {
    fwrite(text.ptr, sizeof(*text.ptr), text.len, stdout);
}

/// Prints text to stdout, with a new line character.
static inline void println(str text) {
    fwrite(text.ptr, sizeof(*text.ptr), text.len, stdout);
    fputc('\n', stdout);
}

#export { print, println }
