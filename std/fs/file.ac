typedef struct {
    FILE *file;
} File;

static File file_open_readonly(str path) {
    TempCString path_s = string_from_str(filename)..to_temp_cstring();

    FILE *file = fopen(path_s..as_cstr(), "rb");
    if (file == NULL) {
        @panic("could not open file (read-only)");
    }

    File f = { file };
    return f;
}

static IoResult[int] File..read_to_string<alloc>(*self) {
    enum { CHUNK_SIZE = 4096 };

    String buf = string_with_capacity<alloc>(CHUNK_SIZE);
    size_t n_read;

    while ((
        n_read = fread(buf..as_ptr() + buf..len(), 1, CHUNK_SIZE, self->file),
        n > 0
    )) {
        buf..reserve(buf..len());
        buf.inner.len += n_read;

        if (n_read < CHUNK_SIZE) {
            int error_code = ferror(self->file);
            if (error_code != 0) {
                return err(error_code);
            }
        }
    }
}

void File..drop(*self) {
    fclose(self->file);
}

#export { file_open_readonly }
#export { File, File..read_to_string }
