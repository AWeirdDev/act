#import std::panic { panic }

#meta neverzero field=inner
#meta privateconstruct
typedef struct {
    T *inner;
} NeverNull[T];

NeverNull[T] nevernull_new(T* ptr) {
    if (ptr == NULL) {
        @panic("found NULL at nevernull_new()")
    }
    return { .inner = ptr };
}

T NeverNull[T]..deref(*self) {
    return *self->inner;
}

#export { NeverNull, nevernull_new }
