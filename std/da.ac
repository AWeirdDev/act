#include <stddef.h>
#include <string.h>

#import std::alloc { Layout, align_of }
#import std::maybe { Maybe, some, none }
#import std::panic { panic }

typedef struct {
    size_t len;
    size_t capacity;
    T *items;
} DynamicArray[T];

static inline DynamicArray[T] da_new<alloc>() {
    DynamicArray[T] arr = { 0 };
    return move(arr);
}

static inline size_t DynamicArray[T]..len(*self) {
    return self->len;
}

static inline size_t DynamicArray[T]..capacity(*self) {
    return self->capacity;
}

/// Allocates a dynamic array with *at least* a capacity of the
/// provided `capacity`.
///
/// The unit is `T`.
static inline DynamicArray[T] da_with_capacity<alloc>(size_t capacity) {
    DynamicArray[T] arr = da_new<alloc>();
    arr..reserve(capacity);
    return move(arr);
}

static inline Layout DynamicArray[T]..current_layout(const *self) {
    return { .size = sizeof(T) * self->capacity, .align = @align_of(T) };
}

static void DynamicArray[T]..reserve<alloc: self>(*self, size_t capacity) {
    if (capacity < self->capacity) {
        @panic("DynamicArray[T]: reserve() with less capacity than current capacity");
    }

    Layout old_layout = {
        .size = self->items == NULL ? 0 : sizeof(T) * self->capacity,
        .align = @align_of(T)
    };
    if (self->capacity == 0) {
        self->capacity = 1;
    }

    while (self->capacity < capacity) {
        self->capacity *= 2;
    }

    self->items = alloc..reallocate(
        self->items,
        old_layout,
        (Layout){ .size = sizeof(T) * self->capacity, .align = @align_of(T) }
    );

    return;
}

static inline void DynamicArray[T]..append<alloc: self>(*self, T item) {
    if (self->len + 1 > self->capacity) {
        self..reserve(self->len + 1);
    }
    self->items[self->len++] = item;
}

static inline Maybe[T] DynamicArray[T]..pop(*self) {
    if (self->len == 0) {
        return none();
    }
    return some(self->items[--self->len]);
}

static inline DynamicArray[T] DynamicArray[T]..copy<alloc>(const *self) {
    T *ptr = alloc..allocate((Layout){ .size = self->capacity, .align = @align_of(T) });
    memcpy(ptr, self->items, self->len);
    DynamicArray[T] new = { .len = self->len, .capacity = self->capacity, .items = ptr };
    return move(new);
}

void DynamicArray[T]..drop<alloc: self>(*self) {
    alloc..deallocate(self->items, self..current_layout());
}

#export { da_new, da_with_capacity }
#export { DynamicArray, DynamicArray..reserve, DynamicArray..append, DynamicArray..copy, DynamicArray..pop }

#tests

#include <assert.h>
#import std::alloc { Allocator, general_allocator }

#test
void general() {
    Allocator gpa = general_allocator();
    DynamicArray[int] a = da_new<gpa>();
    for (int i = 0; i < 100; i++) {
        a..append(10);
    }
    for (int i = 0; i < 50; i++) {
        a..pop();
    }
    assert(a..len() == 50);
}

#endtests
